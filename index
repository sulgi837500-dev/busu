<script>
/* 부수 익히기 (플래시카드) */
function catItems(c){return ITEMS.filter(x=>x.cat===c);}
function renderLearn(){
 const cat=view.cat||'사람',deck=catItems(cat),idx=Math.max(0,Math.min(view.idx||0,deck.length-1)),x=deck[idx];
