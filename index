<!-- 부수 한 걸음 — 한문 부수 수행평가 대비 -->
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<title>부수 한 걸음</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nanum+Myeongjo:wght@400;700;800&family=Gowun+Batang:wght@400;700&family=Jua&display=swap" rel="stylesheet">
<style>
:root{
  --paper:#F7EEDA;        /* 한지 */
  --paper-2:#FCF6E9;
  --ink:#20242F;          /* 먹 */
  --ink-soft:#4A4E5A;
  --seal:#C8322B;         /* 인주(도장) 붉은색 — 시그니처 */
  --seal-deep:#9E241F;
  --celadon:#2F8E7B;      /* 청자 — 정답 */
  --celadon-deep:#216456;
  --ochre:#E0A128;        /* 연속·경험치 */
  --line:#E4D6B8;
  --wrong:#C8322B;
  --shadow:0 10px 30px rgba(32,36,47,.14);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0}
body{
  font-family:'Gowun Batang','Apple SD Gothic Neo','Malgun Gothic',system-ui,sans-serif;
  color:var(--ink);
  background:
    radial-gradient(circle at 12% 8%, rgba(200,50,43,.05), transparent 40%),
    radial-gradient(circle at 88% 92%, rgba(47,142,123,.05), transparent 42%),
    var(--paper);
  min-height:100vh;
}
.serif{font-family:'Nanum Myeongjo','Gowun Batang',serif}
.hanja{font-family:'Nanum Myeongjo',serif;font-weight:800;letter-spacing:.02em}
button{font-family:inherit;cursor:pointer;border:none;background:none}
#app{max-width:480px;margin:0 auto;min-height:100vh;padding:0 18px 40px;display:flex;flex-direction:column}

/* ---------- 상단 바 ---------- */
.topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 2px 6px;position:sticky;top:0;z-index:20;
  background:linear-gradient(var(--paper) 68%, transparent);}
.brand{display:flex;align-items:center;gap:9px;font-family:'Jua',sans-serif;font-size:19px;color:var(--ink)}
.brand .seal-mini{width:30px;height:30px;border-radius:7px;background:var(--seal);color:#fff;display:grid;place-items:center;
  font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:17px;box-shadow:0 3px 0 var(--seal-deep);transform:rotate(-3deg)}
.stats{display:flex;gap:10px;align-items:center}
.chip{display:flex;align-items:center;gap:5px;font-family:'Jua',sans-serif;font-size:15px;padding:5px 11px;border-radius:999px;
  background:var(--paper-2);border:1.5px solid var(--line)}
.chip.flame{color:var(--ochre)} .chip.xp{color:var(--celadon-deep)}

/* ---------- 홈 ---------- */
.hero{margin-top:8px;text-align:center;padding:14px 0 4px}
.hero .kanji-mark{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:15px;color:var(--seal);letter-spacing:.5em;margin-left:.5em}
.hero h1{font-family:'Jua',sans-serif;font-weight:400;font-size:26px;margin:6px 0 2px}
.hero p{margin:0;color:var(--ink-soft);font-size:14px}

.goal-card{margin-top:16px;background:var(--paper-2);border:2px solid var(--line);border-radius:22px;padding:20px;box-shadow:var(--shadow);position:relative;overflow:hidden}
.goal-card:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(90deg,transparent 0 22px,rgba(228,214,184,.35) 22px 23px);pointer-events:none;opacity:.5}
.goal-head{display:flex;justify-content:space-between;align-items:baseline;position:relative}
.goal-head .t{font-family:'Jua',sans-serif;font-size:18px}
.goal-head .n{font-size:13px;color:var(--ink-soft)}
.dots{display:flex;gap:10px;margin:16px 0 4px;position:relative}
.dot{flex:1;height:12px;border-radius:999px;background:var(--line);position:relative;overflow:hidden}
.dot.done{background:var(--celadon)}
.dot .fill{position:absolute;inset:0;background:var(--celadon);transform-origin:left;transition:transform .5s}

.btn{display:block;width:100%;text-align:center;font-family:'Jua',sans-serif;font-size:19px;color:#fff;
  background:var(--seal);border-radius:18px;padding:17px;box-shadow:0 5px 0 var(--seal-deep);transition:transform .05s, box-shadow .05s;margin-top:18px}
.btn:active{transform:translateY(4px);box-shadow:0 1px 0 var(--seal-deep)}
.btn.green{background:var(--celadon);box-shadow:0 5px 0 var(--celadon-deep)}
.btn.green:active{box-shadow:0 1px 0 var(--celadon-deep)}
.btn.ghost{background:var(--paper-2);color:var(--ink);border:2px solid var(--line);box-shadow:0 4px 0 var(--line)}
.btn.ghost:active{box-shadow:0 1px 0 var(--line)}
.btn.small{font-size:16px;padding:13px}
.btn[disabled]{opacity:.5;box-shadow:none;pointer-events:none;transform:none}

.row2{display:flex;gap:12px;margin-top:14px}
.row2 .btn{margin-top:0}

.mini-nav{display:flex;gap:10px;margin-top:20px}
.mini-nav button{flex:1;background:var(--paper-2);border:2px solid var(--line);border-radius:16px;padding:13px 6px;
  display:flex;flex-direction:column;align-items:center;gap:5px;font-family:'Jua',sans-serif;font-size:13px;color:var(--ink)}
.mini-nav button .ic{font-size:20px}

.tip{margin-top:20px;background:linear-gradient(var(--paper-2),var(--paper-2)) padding-box, var(--paper);
  border:2px dashed var(--line);border-radius:16px;padding:14px 16px;font-size:14px;color:var(--ink-soft);line-height:1.6}
.tip b{color:var(--seal)}

/* ---------- 학습(퀴즈) ---------- */
.session-top{display:flex;align-items:center;gap:12px;padding:14px 2px 4px;position:sticky;top:0;z-index:10;background:var(--paper)}
.xbtn{font-size:22px;color:var(--ink-soft);line-height:1;padding:2px 6px}
.pbar{flex:1;height:14px;background:var(--line);border-radius:999px;overflow:hidden}
.pbar .p{height:100%;background:var(--celadon);border-radius:999px;transition:width .35s}
.hearts{display:flex;gap:2px;font-size:16px}

.q-wrap{flex:1;display:flex;flex-direction:column;padding-top:10px;animation:qin .3s ease}
@keyframes qin{from{opacity:0;transform:translateX(18px)}to{opacity:1;transform:none}}
.q-kind{font-family:'Jua',sans-serif;font-size:15px;color:var(--seal);margin:6px 0 2px}
.q-prompt{font-size:16px;color:var(--ink-soft);margin-bottom:16px;line-height:1.5}

.stage{background:var(--paper-2);border:2px solid var(--line);border-radius:22px;padding:26px 18px;text-align:center;box-shadow:var(--shadow);position:relative}
.stage .big-hanja{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:56px;line-height:1.15;color:var(--ink)}
.stage .reading{margin-top:8px;font-size:16px;color:var(--ink-soft);letter-spacing:.15em}
.stage .big-mean{font-size:22px;font-weight:700;line-height:1.5}
.stage .prompt-blank{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:48px;letter-spacing:.05em}
.stage .blank{color:var(--seal);border-bottom:4px solid var(--seal)}

.choices{display:flex;flex-direction:column;gap:11px;margin-top:20px}
.choice{width:100%;text-align:left;background:var(--paper-2);border:2px solid var(--line);border-radius:16px;
  padding:16px 18px;font-size:17px;color:var(--ink);box-shadow:0 4px 0 var(--line);transition:transform .05s,box-shadow .05s;display:flex;align-items:center;gap:12px}
.choice .idx{font-family:'Jua',sans-serif;font-size:13px;width:24px;height:24px;border-radius:7px;background:var(--paper);
  border:1.5px solid var(--line);display:grid;place-items:center;color:var(--ink-soft);flex-shrink:0}
.choice .ch-hanja{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:22px}
.choice:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.choice.correct{background:#E7F3EF;border-color:var(--celadon);box-shadow:0 4px 0 var(--celadon-deep);color:var(--celadon-deep)}
.choice.correct .idx{background:var(--celadon);color:#fff;border-color:var(--celadon)}
.choice.wrong{background:#FBE9E8;border-color:var(--seal);box-shadow:0 4px 0 var(--seal-deep);color:var(--seal-deep)}
.choice.wrong .idx{background:var(--seal);color:#fff;border-color:var(--seal)}
.choice.dim{opacity:.45}
.choice[disabled]{pointer-events:none}

/* 조합(순서 맞추기) */
.assemble-answer{min-height:70px;border:2px dashed var(--line);border-radius:16px;margin-top:18px;padding:12px;
  display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;background:var(--paper-2)}
.assemble-answer:empty:before{content:"여기에 순서대로 배열하세요";color:var(--ink-soft);font-size:14px;opacity:.7}
.assemble-bank{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:16px}
.tile{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:30px;background:var(--paper-2);border:2px solid var(--line);
  border-radius:14px;padding:10px 16px;box-shadow:0 4px 0 var(--line);min-width:56px}
.tile:active{transform:translateY(3px);box-shadow:0 1px 0 var(--line)}
.tile.used{opacity:.28;pointer-events:none}
.tile.in-answer{background:#fff}

/* 피드백 바 */
.feedback{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:18px 18px 26px;
  transform:translateY(110%);transition:transform .3s cubic-bezier(.2,.8,.2,1)}
.feedback.show{transform:none}
.feedback .inner{max-width:480px;margin:0 auto}
.feedback.ok{background:#E2F1EC;border-top:3px solid var(--celadon)}
.feedback.no{background:#FBE7E5;border-top:3px solid var(--seal)}
.fb-title{font-family:'Jua',sans-serif;font-size:19px;display:flex;align-items:center;gap:8px}
.feedback.ok .fb-title{color:var(--celadon-deep)} .feedback.no .fb-title{color:var(--seal-deep)}
.fb-body{font-size:14.5px;color:var(--ink-soft);margin-top:6px;line-height:1.6}
.fb-body .hj{font-family:'Nanum Myeongjo',serif;font-weight:800;color:var(--ink)}
.feedback .btn{margin-top:14px}

/* ---------- 결과 ---------- */
.result{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:30px 0;animation:qin .4s}
.seal-stamp{width:120px;height:120px;border-radius:20px;background:var(--seal);color:#fff;display:grid;place-items:center;
  font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:44px;box-shadow:0 8px 0 var(--seal-deep);transform:rotate(-5deg);
  animation:stamp .5s cubic-bezier(.2,1.4,.4,1);margin-bottom:8px;line-height:1.1;text-align:center}
@keyframes stamp{0%{transform:scale(2.4) rotate(-18deg);opacity:0}60%{transform:scale(.9) rotate(-5deg);opacity:1}100%{transform:scale(1) rotate(-5deg)}}
.result h2{font-family:'Jua',sans-serif;font-size:26px;margin:14px 0 4px}
.result .sub{color:var(--ink-soft);margin-bottom:22px}
.score-grid{display:flex;gap:12px;width:100%;margin-bottom:8px}
.score-box{flex:1;background:var(--paper-2);border:2px solid var(--line);border-radius:18px;padding:16px 8px}
.score-box .v{font-family:'Jua',sans-serif;font-size:26px}
.score-box .l{font-size:13px;color:var(--ink-soft);margin-top:2px}
.score-box.a .v{color:var(--celadon-deep)} .score-box.b .v{color:var(--ochre)} .score-box.c .v{color:var(--seal)}

/* ---------- 진도 / 사전 ---------- */
.screen-title{font-family:'Jua',sans-serif;font-size:22px;margin:6px 0 2px;display:flex;align-items:center;gap:8px}
.screen-sub{color:var(--ink-soft);font-size:14px;margin-bottom:16px}
.unit-block{margin-bottom:20px}
.unit-name{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:16px;color:var(--seal);margin-bottom:10px;display:flex;align-items:center;gap:8px}
.lesson-card{background:var(--paper-2);border:2px solid var(--line);border-radius:16px;padding:14px 16px;margin-bottom:10px;display:flex;align-items:center;gap:14px}
.lesson-card .num{font-family:'Jua',sans-serif;font-size:15px;width:38px;height:38px;border-radius:11px;background:var(--paper);border:2px solid var(--line);display:grid;place-items:center;flex-shrink:0}
.lesson-card.mastered .num{background:var(--seal);color:#fff;border-color:var(--seal)}
.lesson-card .info{flex:1;min-width:0}
.lesson-card .info .lt{font-weight:700;font-size:15px}
.lesson-card .info .lc{font-size:12.5px;color:var(--ink-soft);margin-top:2px}
.mbar{height:8px;background:var(--line);border-radius:999px;overflow:hidden;margin-top:7px}
.mbar .m{height:100%;background:var(--celadon);border-radius:999px}
.lesson-card .go{font-family:'Jua',sans-serif;font-size:13px;color:#fff;background:var(--celadon);border-radius:10px;padding:8px 12px;box-shadow:0 3px 0 var(--celadon-deep);flex-shrink:0}
.lesson-card .go:active{transform:translateY(2px);box-shadow:0 1px 0 var(--celadon-deep)}

.dict-tabs{display:flex;gap:8px;margin-bottom:14px;overflow-x:auto;padding-bottom:2px}
.dict-tab{font-family:'Jua',sans-serif;font-size:13.5px;white-space:nowrap;padding:8px 14px;border-radius:999px;background:var(--paper-2);border:2px solid var(--line);color:var(--ink-soft)}
.dict-tab.on{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.dict-item{background:var(--paper-2);border:2px solid var(--line);border-radius:14px;padding:14px 16px;margin-bottom:9px;display:flex;gap:14px;align-items:center}
.dict-item .dh{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:28px;flex-shrink:0;min-width:56px;text-align:center}
.dict-item .dr{font-size:12.5px;color:var(--seal);letter-spacing:.1em}
.dict-item .dm{font-size:14.5px;margin-top:2px;line-height:1.4}
.dict-item .star{margin-left:auto;font-size:18px;color:var(--line);flex-shrink:0}
.dict-item .star.on{color:var(--ochre)}

/* ---------- 온보딩 / 범위 선택 ---------- */
.ob{padding-top:20px;animation:qin .4s}
.ob h1{font-family:'Jua',sans-serif;font-size:24px;text-align:center;margin:10px 0 4px}
.ob p.lead{text-align:center;color:var(--ink-soft);font-size:14px;margin:0 0 18px;line-height:1.6}
.scope-unit{border:2px solid var(--line);border-radius:16px;margin-bottom:11px;overflow:hidden;background:var(--paper-2)}
.scope-unit .uhead{display:flex;align-items:center;gap:12px;padding:14px 16px}
.scope-unit .uhead .cbx{width:26px;height:26px;border-radius:8px;border:2.5px solid var(--line);flex-shrink:0;display:grid;place-items:center;font-size:16px;color:#fff;background:var(--paper)}
.scope-unit.on .uhead .cbx{background:var(--seal);border-color:var(--seal)}
.scope-unit .uhead .un{font-family:'Nanum Myeongjo',serif;font-weight:800;font-size:15px}
.scope-unit .uhead .us{font-size:12px;color:var(--ink-soft);margin-top:1px}
.scope-unit .uhead .rn{margin-left:auto;font-family:'Nanum Myeongjo',serif;font-weight:800;color:var(--seal);font-size:15px}

.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(120%);background:var(--ink);color:var(--paper);
  padding:12px 20px;border-radius:14px;font-family:'Jua',sans-serif;font-size:14px;z-index:50;transition:transform .3s;box-shadow:var(--shadow)}
.toast.show{transform:translateX(-50%)}
.hidden{display:none!important}
.center-note{text-align:center;color:var(--ink-soft);font-size:14px;padding:40px 0;line-height:1.7}

/* 배우기 카드 / 플래시카드 */
.stage.learn{border-color:var(--seal);border-style:solid}
.learn-badge{display:inline-block;font-family:'Jua',sans-serif;font-size:12px;color:#fff;background:var(--seal);border-radius:999px;padding:3px 12px;margin-bottom:14px}
.learn-reading{font-family:'Nanum Myeongjo',serif;font-weight:700;font-size:26px;color:var(--seal);letter-spacing:.15em;margin-top:12px}
.learn-mean{font-size:19px;font-weight:700;margin-top:10px;line-height:1.5}
.learn-hint{font-size:14px;color:var(--ink-soft);margin-top:14px;line-height:1.65;border-top:1.5px dashed var(--line);padding-top:12px}

.flash-chips{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px;margin-bottom:14px}
.flash-card{background:var(--paper-2);border:2px solid var(--line);border-radius:24px;padding:38px 20px;text-align:center;
  box-shadow:var(--shadow);min-height:320px;display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}
.flash-type{position:absolute;top:14px;left:16px;font-family:'Jua',sans-serif;font-size:12px;color:var(--seal);
  background:var(--paper);border:1.5px solid var(--line);border-radius:999px;padding:3px 11px}
.flash-star{position:absolute;top:11px;right:14px;font-size:23px;color:var(--line);background:none}
.flash-star.on{color:var(--ochre)}
.flash-hanja{font-family:'Nanum Myeongjo',serif;font-weight:800;line-height:1.12}
.flash-reading{font-family:'Nanum Myeongjo',serif;font-weight:700;font-size:30px;color:var(--seal);letter-spacing:.15em;margin-top:16px}
.flash-mean{font-size:21px;font-weight:700;margin-top:12px;line-height:1.5}
.flash-hint{font-size:14px;color:var(--ink-soft);margin-top:16px;line-height:1.65;border-top:1.5px dashed var(--line);padding-top:14px;max-width:340px}
.flash-tap{font-size:14px;color:var(--ink-soft);opacity:.75;margin-top:22px}
.flash-nav{display:flex;gap:10px;align-items:center;margin-top:16px}
.flash-nav .navb{margin-top:0}
.flash-count{font-family:'Jua',sans-serif;font-size:15px;color:var(--ink-soft);min-width:62px;text-align:center}

.toggle-row{display:flex;align-items:center;justify-content:space-between;gap:14px;background:var(--paper-2);
  border:2px solid var(--line);border-radius:16px;padding:14px 16px;margin-top:14px}
.switch{width:52px;height:30px;border-radius:999px;background:var(--line);position:relative;transition:background .2s;flex-shrink:0}
.switch.on{background:var(--celadon)}
.switch .knob{position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:left .2s;box-shadow:0 1px 3px rgba(0,0,0,.25)}
.switch.on .knob{left:25px}

/* 도움말 버튼 */
.chip.help{font-family:'Jua',sans-serif;font-size:16px;width:32px;height:32px;padding:0;border-radius:50%;
  background:var(--paper-2);border:1.5px solid var(--line);color:var(--ink-soft);
  display:grid;place-items:center;line-height:1}
.chip.help:active{transform:translateY(1px)}
.chip.flame,.chip.xp{cursor:pointer}

/* 기록 달력 */
.stat-row{display:flex;gap:8px;margin-bottom:16px}
.stat{flex:1;background:var(--paper-2);border:2px solid var(--line);border-radius:14px;padding:12px 3px;text-align:center}
.stat .v{font-family:'Jua',sans-serif;font-size:18px} .stat .l{font-size:11px;color:var(--ink-soft);margin-top:3px}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12px}
.cal-title{font-family:'Jua',sans-serif;font-size:17px}
.cal-nav{width:40px;height:40px;border-radius:11px;background:var(--paper-2);border:2px solid var(--line);font-size:22px;color:var(--ink);line-height:1}
.cal-nav:active{transform:translateY(1px)}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.cal-dow{text-align:center;font-size:12px;color:var(--ink-soft);padding:2px 0 4px;font-family:'Jua',sans-serif}
.cal-dow.sun{color:var(--seal)}
.cal-day{aspect-ratio:1/1;border-radius:12px;background:var(--paper-2);border:2px solid var(--line);
  display:flex;flex-direction:column;align-items:center;justify-content:center;position:relative}
.cal-day .dn{font-size:14px;color:var(--ink-soft)}
.cal-day.partial{border-color:var(--ochre);background:#FBF1DA} .cal-day.partial .dn{color:#B9791A;font-weight:700}
.cal-day.goal{background:var(--seal);border-color:var(--seal);box-shadow:0 3px 0 var(--seal-deep)} .cal-day.goal .dn{color:#fff;font-weight:700}
.cal-day.goal .dm{position:absolute;bottom:1px;font-family:'Nanum Myeongjo',serif;font-size:9px;color:rgba(255,255,255,.8)}
.cal-day.today{outline:3px solid var(--celadon);outline-offset:1px}
.cal-legend{display:flex;gap:16px;flex-wrap:wrap;justify-content:center;margin:18px 0;font-size:12.5px;color:var(--ink-soft)}
.cal-legend span{display:flex;align-items:center;gap:6px}
.cal-legend .lg{width:15px;height:15px;border-radius:5px;display:inline-block;border:2px solid var(--line);background:var(--paper-2)}
.cal-legend .lg.goal{background:var(--seal);border-color:var(--seal)}
.cal-legend .lg.partial{background:#FBF1DA;border-color:var(--ochre)}
.cal-legend .lg.today{outline:2px solid var(--celadon);outline-offset:1px}

/* 학습 순서 안내 */
