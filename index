 if(rev&&x&&!S.prog[x.id].taught){S.prog[x.id].taught=true;save();}
 let h=topbar()+`<div class="screen-title">📇 부수 익히기</div>
  <p class="screen-sub">갈래별로 카드를 넘기며 뜻·음을 익혀요. 변형 모양도 함께 나와요.</p>
  <div class="flash-chips">${CATS.map(c=>`<button class="dict-tab ${c===cat?'on':''}" data-c="${c}">${c} ${catItems(c).length}</button>`).join('')}</div>`;
 if(!x)h+=`<div class="center-note">항목이 없어요.</div>`;else{
 h+=`<div class="flash-card" id="fc"><span class="flash-type">${cat}</span>
  <div class="flash-hanja" style="font-size:${x.c.length>=4?42:66}px">${x.c}</div>
  ${rev?`<div class="flash-reading">${x.t==='rad'?x.m+'('+x.s+')':(x.s||'')}</div>
   ${x.t==='rad'&&x.v?`<div class="flash-mean">변형 모양 · <span class="serif" style="color:var(--seal);font-size:26px">${x.v}</span></div>`:''}
   ${x.t==='combo'?`<div class="flash-mean">${x.m}(${x.s})</div><div class="flash-hint">${x.parts.map(p=>p+'('+(RADBY[p]?RADBY[p].m:'')+')').join(' + ')} · ${x.pr}</div>`:''}
   ${x.t==='word'?`<div class="flash-mean">${x.m}</div><div class="flash-hint">짜임: ${x.st}</div>`:''}
   ${x.t==='idiom'?`<div class="flash-mean">${x.m}</div><div class="flash-hint">속뜻: ${x.hid}</div>`:''}`
  :`<div class="flash-tap">👆 탭하여 뜻·음 확인</div>`}</div>
 <div class="flash-nav"><button class="btn ghost small navb" id="pv" ${idx===0?'disabled':''}>← 이전</button>
  <div class="flash-count">${idx+1} / ${deck.length}</div>
  <button class="btn ghost small navb" id="nx2" ${idx===deck.length-1?'disabled':''}>다음 →</button></div>
 <div class="toggle-row"><div><div style="font-weight:700;font-size:14.5px">스스로 확인 모드</div>
  <div style="font-size:12.5px;color:var(--ink-soft)">뜻·음을 가리고 떠올려 봐요</div></div>
  <div class="switch ${view.self?'on':''}" id="sw"><span class="knob"></span></div></div>`;}
 h+=`<button class="btn small" id="tq" style="margin-top:16px">이 갈래 문제 풀기 →</button>
  <button class="btn ghost small" id="bh" style="margin-top:10px">← 홈으로</button>`;
 app.innerHTML=h;
 app.querySelectorAll('.flash-chips .dict-tab').forEach(b=>b.onclick=()=>go('learn',{cat:b.dataset.c,idx:0,self:view.self,rev:false}));
 if(x){fc.onclick=()=>{if(view.self&&!view.rev)go('learn',{cat,idx,self:true,rev:true});};
  if(pv)pv.onclick=()=>go('learn',{cat,idx:idx-1,self:view.self,rev:false});
  if(nx2)nx2.onclick=()=>go('learn',{cat,idx:idx+1,self:view.self,rev:false});
  sw.onclick=()=>go('learn',{cat,idx,self:!view.self,rev:false});}
 tq.onclick=()=>start(cat);bh.onclick=()=>go('home');}

/* 쓰기 연습 */
function renderWrite(){
 const deck=ITEMS.filter(x=>x.t==='rad'||x.t==='combo'),idx=Math.max(0,Math.min(view.idx||0,deck.length-1)),x=deck[idx];
 app.innerHTML=topbar()+`<div class="screen-title">✍️ 한자 쓰기 연습</div>
  <p class="screen-sub">시험 41~50번 대비예요. 뜻과 음을 보고 <b>종이에 직접 써 본 뒤</b> 탭해서 맞춰 보세요.</p>
  <div class="write-card" id="wc">${view.rev?`<div class="write-ans">${x.c}</div>
    <div class="write-prompt" style="font-size:19px;margin-top:14px">${x.t==='rad'?x.m+'('+x.s+')':x.m+'('+x.s+')'}</div>
    ${x.t==='rad'&&x.v?`<div class="flash-hint">변형 모양: <span class="serif" style="font-size:22px;color:var(--seal)">${x.v}</span></div>`:''}`
   :`<div class="write-prompt">${x.t==='rad'?x.m+'('+x.s+')':x.m+'('+x.s+')'}</div><div class="write-tap">👆 종이에 쓴 뒤 탭해서 확인</div>`}</div>
  <div class="flash-nav"><button class="btn ghost small navb" id="pv" ${idx===0?'disabled':''}>← 이전</button>
   <div class="flash-count">${idx+1} / ${deck.length}</div>
   <button class="btn ghost small navb" id="nx2" ${idx===deck.length-1?'disabled':''}>다음 →</button></div>
  ${view.rev?`<div class="row2" style="margin-top:14px">
   <button class="btn green small" id="ok">맞았어요</button><button class="btn small" id="no">틀렸어요</button></div>`:''}
  <button class="btn ghost small" id="bh" style="margin-top:12px">← 홈으로</button>`;
 wc.onclick=()=>{if(!view.rev)go('write',{idx,rev:true});};
 if(pv)pv.onclick=()=>go('write',{idx:idx-1,rev:false});
 if(nx2)nx2.onclick=()=>go('write',{idx:idx+1,rev:false});
 if(view.rev){ok.onclick=()=>{upd(x.id,true);save();go('write',{idx:Math.min(idx+1,deck.length-1),rev:false});};
  no.onclick=()=>{upd(x.id,false);save();go('write',{idx:Math.min(idx+1,deck.length-1),rev:false});};}
 bh.onclick=()=>go('home');}

/* 부수표 보기 */
function renderList(){
 const cat=view.cat||'사람',items=catItems(cat);
 app.innerHTML=topbar()+`<div class="screen-title">📖 부수표</div>
