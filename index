  ${['결합','한자어','성어'].includes(cat)?
   items.map(x=>`<div class="dict-item"><div class="dh">${x.c}</div><div style="flex:1;min-width:0">
    <div class="dr">${x.t==='combo'?x.m+'('+x.s+') · '+x.pr:(x.s||x.st||'')}</div>
    <div class="dm">${x.t==='combo'?x.parts.map(p=>p+'('+(RADBY[p]?RADBY[p].m:'')+')').join(' + '):x.m}</div>
    ${x.t==='idiom'?`<div class="dm" style="font-size:12.5px;color:var(--ink-soft)">속뜻: ${x.hid}</div>`:''}
    ${x.t==='word'?`<div class="dm" style="font-size:12.5px;color:var(--ink-soft)">짜임: ${x.st}</div>`:''}
    <div class="mbar" style="margin-top:6px"><div class="m" style="width:${mastery(x.id)*100}%"></div></div></div></div>`).join('')
   :`<div class="grid-rad">${items.map(x=>`<div class="rad-cell ${S.prog[x.id].box>=4?'mastered':''}">
    <div class="rc">${x.c}</div><div class="rr">${x.m}(${x.s})</div>${x.v?`<div class="rv">→ ${x.v}</div>`:''}</div>`).join('')}</div>`}
  <button class="btn ghost" id="bh" style="margin-top:16px">← 홈으로</button>`;
 app.querySelectorAll('.flash-chips .dict-tab').forEach(b=>b.onclick=()=>go('list',{cat:b.dataset.c}));
 bh.onclick=()=>go('home');}

/* 진도 + 설정 */
function renderScope(){
 const prog=view.tab==='progress';
 app.innerHTML=topbar()+`<div class="screen-title">${prog?'🗺️ 나의 진도':'⚙️ 설정'}</div>
  <p class="screen-sub">${prog?'갈래별로 얼마나 익혔는지 볼 수 있어요.':'시험 범위에서 뺄 갈래가 있으면 꺼 두세요.'}</p>
  ${CATS.map(c=>{const m=Math.round(catMastery(c)*100),on=S.scope.includes(c);
   return prog?`<div class="lesson-card ${m>=80?'mastered':''}"><div class="num">${m>=80?'✓':catItems(c).length}</div>
    <div class="info"><div class="lt">${c}</div><div class="lc">${catItems(c).length}개 항목 · ${m}% 익힘</div>
    <div class="mbar"><div class="m" style="width:${m}%"></div></div></div>
    <button class="go" data-c="${c}">연습</button></div>`
   :`<div class="scope-unit ${on?'on':''}" data-c="${c}"><div class="uhead"><div class="cbx">${on?'✓':''}</div>
    <div><div class="un">${c}</div><div class="us">${catItems(c).length}개 항목</div></div>
    <div class="rn">${Math.round(catMastery(c)*100)}%</div></div></div>`;}).join('')}
  ${prog?'':`<button class="btn green" id="sv" style="margin-top:16px">저장하고 홈으로</button>`}
  <button class="btn ghost small" id="bh" style="margin-top:10px">← 홈으로</button>`;
 if(prog)app.querySelectorAll('.go').forEach(b=>b.onclick=()=>start(b.dataset.c));
 else{app.querySelectorAll('.scope-unit').forEach(el=>el.querySelector('.uhead').onclick=()=>{
   const c=el.dataset.c;if(S.scope.includes(c)){S.scope=S.scope.filter(z=>z!==c);el.classList.remove('on');el.querySelector('.cbx').textContent='';}
   else{S.scope.push(c);el.classList.add('on');el.querySelector('.cbx').textContent='✓';}});
  sv.onclick=async()=>{if(!S.scope.length){toast('한 갈래 이상 골라 주세요');return;}await save();toast('저장했어요');go('home');};}
 bh.onclick=()=>go('home');}

/* 기록 달력 */
function renderRecords(){
 const p=(view.ym||(new Date().getFullYear()+'-'+(new Date().getMonth()+1))).split('-'),y=+p[0],m=+p[1];
 const sd=new Date(y,m-1,1).getDay(),days=new Date(y,m,0).getDate(),t=todayStr();
 const mc=Object.keys(S.history).filter(k=>{const q=k.split('-');return +q[0]===y&&+q[1]===m;}).length;
 let cells='';for(let i=0;i<sd;i++)cells+='<div></div>';
 for(let d=1;d<=days;d++){const k=y+'-'+m+'-'+d,h=S.history[k];let c='cal-day';
  if(h&&h.goal)c+=' goal';else if(h)c+=' partial';if(k===t)c+=' today';
  cells+=`<div class="${c}"><span class="dn">${d}</span>${h&&h.exam?'<span class="dm">試</span>':h&&h.goal?'<span class="dm">印</span>':''}</div>`;}
 app.innerHTML=topbar()+`<div class="screen-title">🗓️ 학습 기록</div>
  <p class="screen-sub">언제 공부했는지, 목표(2세션)를 채웠는지 한눈에 봐요.</p>
  <div class="stat-row"><div class="stat"><div class="v">🔥${S.streak}</div><div class="l">현재 연속</div></div>
   <div class="stat"><div class="v">${S.maxStreak||0}</div><div class="l">최장 연속</div></div>
   <div class="stat"><div class="v">${mc}</div><div class="l">이번 달</div></div>
   <div class="stat"><div class="v">${S.best||0}</div><div class="l">모의 최고</div></div></div>
  <div class="cal-head"><button class="cal-nav" id="pm">‹</button><div class="cal-title">${y}년 ${m}월</div><button class="cal-nav" id="nm">›</button></div>
  <div class="cal-grid">${['일','월','화','수','목','금','토'].map((w,i)=>`<div class="cal-dow ${i===0?'sun':''}">${w}</div>`).join('')}${cells}</div>
  <div class="cal-legend"><span><i class="lg goal"></i>목표 달성</span><span><i class="lg partial"></i>1세션</span><span><i class="lg today"></i>오늘</span></div>
  <button class="btn ghost" id="bh">← 홈으로</button>`;
 pm.onclick=()=>{let mm=m-1,yy=y;if(mm<1){mm=12;yy--;}go('records',{ym:yy+'-'+mm});};
 nm.onclick=()=>{let mm=m+1,yy=y;if(mm>12){mm=1;yy++;}go('records',{ym:yy+'-'+mm});};
 bh.onclick=()=>go('home');}

