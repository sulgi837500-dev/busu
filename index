 return ['idiom-hid','idiom-hid','idiom-asm','idiom-asm','idiom-mean','idiom-term'];
}
function makeQ(x,forceKind){
 const ks=kindsFor(x),kind=forceKind||ks[Math.random()*ks.length|0];
 const q={item:x,kind,lvl:S.level||'normal'},D=lv().n-1;
 const rads=ITEMS.filter(i=>i.t==='rad'&&i.id!==x.id),
       cmb=ITEMS.filter(i=>i.t==='combo'&&i.id!==x.id),
       wrd=ITEMS.filter(i=>i.t==='word'&&i.id!==x.id),
       idm=ITEMS.filter(i=>i.t==='idiom'&&i.id!==x.id),
       vrs=ITEMS.filter(i=>i.v&&i.id!==x.id);
 if(kind==='meaning'){q.sec='뜻과 음';q.prompt='이 한자(부수)의 뜻과 음은?';q.show='char';
  const a=x.m+'('+x.s+')';q.answer=a;q.options=shuffle([a,...distract(x,rads,r=>r.m+'('+r.s+')',a,D)]);}
 else if(kind==='term'){q.sec='한자 쓰기';q.prompt='뜻과 음에 맞는 한자(부수)는?';q.show='mean';
  q.answer=x.c;q.options=shuffle([x.c,...distract(x,rads,r=>r.c,x.c,D)]);q.big=true;}
 else if(kind==='v2'){q.sec='변형된 모양';q.prompt='이 한자의 변형된 모양은?';q.show='char';
  q.answer=x.v;q.options=shuffle([x.v,...pickN(vrs.map(i=>i.v),x.v,D)]);q.big=true;}
 else if(kind==='v1'){q.sec='원래 모양';q.prompt='이 부수의 원래 모양은?';q.show='variant';
  q.answer=x.c;q.options=shuffle([x.c,...pickN(vrs.map(i=>i.c),x.c,D)]);q.big=true;}
 else if(kind==='combo'){q.sec='부수 결합';q.prompt='두 부수를 합하면 어떤 한자가 될까요?';q.show='combo';
  q.answer=x.c;q.options=shuffle([x.c,...pickN(cmb.map(i=>i.c),x.c,D)]);q.big=true;}
 else if(kind==='combo-split'){q.sec='부수 결합';q.prompt='이 한자는 어떤 부수로 이루어졌나요?';q.show='char';
  const mk=i=>i.parts.map(p=>p+'('+(RADBY[p]?RADBY[p].m:'')+')').join(' + ');
  q.answer=mk(x);q.options=shuffle([mk(x),...pickN(cmb.map(mk),mk(x),D)]);}
 else if(kind==='principle'){q.sec='한자의 짜임';q.prompt='이 한자를 만든 원리는?';q.show='char';
  q.options=['상형','지사','회의','형성'];q.answer=x.pr;q.fixed=true;}
 else if(kind==='word-mean'){q.sec='한자어';q.prompt='이 한자어의 뜻은?';q.show='char';
  q.answer=x.m;q.options=shuffle([x.m,...pickN(wrd.map(i=>i.m),x.m,D)]);}
 else if(kind==='word-st'){q.sec='단어의 짜임';q.prompt='이 한자어의 짜임은?';q.show='char';
  q.options=['수식관계','병렬관계','주술관계','술목관계'];q.answer=x.st;q.fixed=true;}
 else if(kind==='idiom-mean'){q.sec='성어 풀이';q.prompt='이 성어의 풀이는?';q.show='char';
  q.answer=x.m;q.options=shuffle([x.m,...pickN(idm.map(i=>i.m),x.m,D)]);}
 else if(kind==='idiom-hid'){q.sec='성어 속뜻';q.prompt='이 성어의 속뜻은?';q.show='char';
  q.answer=x.hid;q.options=shuffle([x.hid,...pickN(idm.map(i=>i.hid),x.hid,D)]);}
 else if(kind==='idiom-term'){q.sec='성어 찾기';q.prompt='풀이에 맞는 성어는?';q.show='mean';
  q.answer=x.c;q.options=shuffle([x.c,...pickN(idm.map(i=>i.c),x.c,D)]);q.big=true;}
 else{q.sec='성어 배열';q.prompt='뜻을 보고 순서대로 배열하세요';q.kind='idiom-asm';
  q.tiles=shuffle([...x.c]);q.answer=x.c;}
 return q;
}
const N=8;
function buildSession(cat){
 let pool=cat?ITEMS.filter(x=>x.cat===cat):inScope();
 if(!pool.length)return [];
 const now=Date.now();
 const due=pool.filter(x=>S.prog[x.id].seen&&S.prog[x.id].due<=now).sort((a,b)=>S.prog[a.id].due-S.prog[b.id].due);
 const fresh=pool.filter(x=>!S.prog[x.id].seen);
 let p=due.slice(0,5); p=p.concat(fresh.slice(0,Math.max(N-p.length-2,3)));
 if(p.length<N){const rest=pool.filter(x=>!p.includes(x)).sort((a,b)=>mastery(a.id)-mastery(b.id));p=p.concat(rest.slice(0,N-p.length));}
 return shuffle(p).slice(0,N).map(x=>makeQ(x));
}
/* 실전 모의고사 25문항 — 수행평가 구성 비율 */
function buildExam(){
 const R=ITEMS.filter(x=>x.t==='rad'),C=ITEMS.filter(x=>x.t==='combo'),
       V=ITEMS.filter(x=>x.v),W=ITEMS.filter(x=>x.t==='word'),I=ITEMS.filter(x=>x.t==='idiom');
 const qs=[];
 shuffle(C).slice(0,5).forEach(x=>qs.push(makeQ(x,'combo')));
 shuffle(V).slice(0,2).forEach(x=>qs.push(makeQ(x,'v2')));
 shuffle(V).slice(0,3).forEach(x=>qs.push(makeQ(x,'v1')));
 shuffle(R).slice(0,8).forEach(x=>qs.push(makeQ(x,'meaning')));
 shuffle(R).slice(8,12).forEach(x=>qs.push(makeQ(x,'term')));
 shuffle(I).slice(0,3).forEach((x,i)=>qs.push(makeQ(x,i%2?'idiom-hid':'idiom-mean')));
 return qs.slice(0,25);
}
