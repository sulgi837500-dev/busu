  ${sess.wrong.length?`<div class="tip" style="text-align:left;width:100%">틀린 항목 (복습 예약됨)<br>${sess.wrong.map(w=>`<b class="serif">${w.c}</b> ${w.t==='rad'?w.m+'('+w.s+')':w.m}`).join('<br>')}</div>`:'<div class="tip">전부 정답이에요! 대단해요 🎉</div>'}
  <button class="btn green" id="a" style="width:100%">다시 풀기</button>
  <button class="btn ghost small" id="h" style="width:100%;margin-top:10px">홈으로</button></div>`;
 a.onclick=()=>startExam();h.onclick=()=>go('home');}
